# APP_URL: Public URL where Quietbox is hosted (injected automatically in AI Studio / Cloud Run).
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Platform-managed Gemini API key (unused unless moderation extensions are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server HTTP port (defaults to 3000).
PORT="3000"

# MAX_UPLOAD_SIZE_MB: Maximum allowed image upload size in megabytes (defaults to 5).
MAX_UPLOAD_SIZE_MB="5"

# STORAGE_SIGNING_SECRET: Optional HMAC secret for short-lived signed attachment tokens when local fallback storage is active.
STORAGE_SIGNING_SECRET="replace_with_32_byte_random_hex_in_production"

# OPTIONAL SUPABASE ADAPTER VARIABLES (For external Vercel + Supabase PostgreSQL deployments; see /supabase/migrations/001_initial_schema.sql)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
